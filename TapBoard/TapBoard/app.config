<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Opt-in diagnostics. Periodic snapshots are written outside touch callbacks. -->
    <add key="TraceTouches" value="true" />
    <!-- Use "file" for legacy JSONL logging in Documents/TapBoard-Experiments. -->
    <add key="ExperimentConnection" value="direct" />
    <add key="ExperimentLogging" value="true" />
    <!-- Block touch-generated mouse events over TapBoard while it is running. -->
    <add key="FilterTouchMouse" value="true" />
    <!-- Independently enable touch-down and accepted-input audio feedback. -->
    <add key="TouchSoundEnabled" value="false" />
    <add key="InputSoundEnabled" value="true" />
    <!-- Blank selects the lowest display in Windows Display Settings. -->
    <add key="KeyboardDisplay" value="" />
    <!-- 0 uses monitor dimensions; set visible screen width in mm to calibrate. -->
    <add key="DisplayWidthMm" value="0" />
    <!-- Brief taps commit on release; long resting contacts never type. -->
    <add key="TapDurationMs" value="300" />
    <!-- Inclusive minimum contact duration for tapping keys; 0 disables. -->
    <add key="TapMinDurationMs" value="10" />
    <add key="TapDistancePixels" value="60" />
    <!-- Limit distinct non-modifier keys; Shift/Ctrl/Alt/Win do not count. -->
    <add key="MaxActiveKeys" value="2" />
    <!-- Immediate first input; wait this long before held Backspace/arrow repeats. -->
    <add key="RepeatDelayMs" value="450" />
    <!-- Subsequent repeats keep this interval, independently of the initial delay. -->
    <add key="RepeatIntervalMs" value="100" />
    <!-- Suppress consecutive same-key taps less than this interval apart; 0 disables. -->
    <add key="SameKeyMinIntervalMs" value="100" />
    <!-- Space extends downward only; visual geometry remains unchanged. -->
    <add key="SpaceHitHeightMultiplier" value="2" />
    <add key="KeyPitchMm" value="19.5" />
    <add key="LockedBrightness" value="0.85" />
    <!-- C4 touch and E4 input: independent pure sine voices. -->
    <add key="TouchFrequencyHz" value="261.625565" />
    <add key="InputFrequencyHz" value="329.627557" />
    <add key="TouchGain" value="0.07" />
    <add key="InputGain" value="0.12" />
    <add key="TouchDurationMs" value="70" />
    <add key="InputDurationMs" value="60" />
  </appSettings>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Blank selects the display with the lowest bottom edge in Windows. -->
    <add key="KeyboardDisplay" value="" />
    <!-- For a study, use the measured visible display width, in millimetres. -->
    <add key="DisplayWidthMm" value="0" />
    <add key="KeyPitchMm" value="19.5" />
    <add key="ExperimentConnection" value="direct" />
    <add key="ExperimentLogging" value="true" />
    <add key="FilterTouchMouse" value="true" />
    <add key="TouchSoundEnabled" value="false" />
    <add key="InputSoundEnabled" value="true" />
    <add key="RepeatDelayMs" value="450" />
    <add key="RepeatIntervalMs" value="100" />
  </appSettings>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
</configuration>
